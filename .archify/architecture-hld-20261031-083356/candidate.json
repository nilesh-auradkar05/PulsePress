  "cards": [
    {
      "dot": "cyan",
      "title": "Two write-shapes, one backbone",
      "items": [
        "Commerce writes: Idempotency-Key, atomic outbox row, worker-written ledger.",
        "Publishing writes: plain CRUD; publishPost is the single event door.",
        "Both producers feed the same outbox -> EventBridge -> SQS -> worker path."
      ]
    },
    {
      "dot": "emerald",
      "title": "Exactly-once effects on at-least-once delivery",
      "items": [
        "Poller: SELECT FOR UPDATE SKIP LOCKED, publish then mark, backoff, terminal after 10 attempts.",
        "Worker: durable claim lease per event_id, write-once S3 receipt, single handler transaction, SQS delete only after commit.",
        "Ledger: one balanced ledger_transactions row + three ledger_entries, UNIQUE(source_type, source_id)."
      ]
    },
    {
      "dot": "rose",
      "title": "Current gaps",
      "items": [
        "ALB is HTTP-only; TLS is required before the Cognito browser flow.",
        "Only 6 of 10 event types are routed today; post.published stays pending until Sprint 5.",
        "Redis pub/sub, SSE, metrics and alarms are Sprint 5-6 work."
      ]
    }
  ]
}